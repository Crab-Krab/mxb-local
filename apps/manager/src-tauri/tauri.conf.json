{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MXB Local",
  "mainBinaryName": "MXB Local",
  "version": "0.20.6-local.3",
  "identifier": "local.mxb.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MXB Local",
        "width": 1400,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": false,
        "create": false,
        "visible": false,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: imgcache: http://imgcache.localhost https://imgcache.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://imgcache.localhost https://imgcache.localhost https://api.mxbsecure.com; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mxblocal"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "createUpdaterArtifacts": false,
    "licenseFile": "../../../LICENSE",
    "publisher": "Independent local fork",
    "copyright": "Copyright \u00a9 2026 Frost",
    "shortDescription": "Personal MX Bikes mod manager",
    "longDescription": "MXB Local is a personal, privacy-focused MX Bikes mod manager. Browse mod catalogs and install tracks, bikes and paints.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ]
      }
    }
  }
}
